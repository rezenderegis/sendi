# Criptografia AES-256 (exatamente 32 caracteres)
ENCRYPTION_KEY=Sendi2024EncryptKey32Chars!!!!!!

# OpenAI (LLM)
OPENAI_API_KEY=sk-...

# URL pública da API (usada pra montar a URL das mock tools de demo). Em produção,
# defina como https://api.sende.app.br
PUBLIC_API_URL=http://localhost:3000

# Opcional: id da empresa (companies.id) onde a migration SeedMockTools deve criar as
# tools fake de demonstração (consulta CPF, boleto etc). Sem essa variável, a seed não
# cria nada em nenhuma empresa — não setar em produção fora da sua própria conta.
DEMO_SEED_COMPANY_ID=
